      "suave": "#4A5560",
      "muda": "#8B95A1"
    },
    "escalaInk": {
      "$comentario": "La escala `ink.*` de los DOS tailwind.config (idéntica en dashboard y marketing). Se preserva TAL CUAL para que el preset emita el mismo CSS.",
