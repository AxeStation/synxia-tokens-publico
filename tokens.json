    "$comentario_escalas": "Escalas por NUMERO: mas alto = mas oscuro, espejo de la escala base (accion-600 = el color de accion principal). 'color-accion' y 'color-tinta' a secas son alias del principal de cada escala."
  },
  "tipografia": {
    "$comentario": "Una sola declaración de familias, pesos y escala. Las apps cargan las webfonts con next/font (obligatorio en Next: es macro de compilación), pero el NOMBRE de familia, los pesos y la escala salen de aquí.",
    "familias": {
      "titulos": {
        "nombre": "Fraunces",
        "fallback": "Georgia, 'Times New Roman', serif",
        "pesos": [
          500,
          600,
          700
        ],
        "cursiva": true
      },
      "texto": {
        "nombre": "Inter",
        "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif",
        "pesos": [
          400,
          500,
          600,
          700,
          800
        ]
      },
      "datos": {
        "nombre": null,
        "fallback": "'SF Mono', 'Fira Code', 'JetBrains Mono', ui-monospace, monospace",
        "pesos": [
          400,
          500
        ]
      },
      "correo-titulos": {
        "$comentario": "Los clientes de correo no cargan webfonts: la marca en correo usa serif del sistema.",
        "nombre": null,
        "fallback": "Georgia, 'Times New Roman', serif"
      },
      "correo-texto": {
        "nombre": null,
        "fallback": "Helvetica, Arial, sans-serif"
      }
    },
    "escala": {
      "titulo-grande": {
        "tamano": "32px",
        "peso": 600,
        "familia": "titulos",
        "interlineado": "1.15"
      },
      "titulo": {
        "tamano": "24px",
        "peso": 600,
        "familia": "titulos",
        "interlineado": "1.2"
      },
      "subtitulo": {
        "tamano": "18px",
        "peso": 600,
        "familia": "texto",
        "interlineado": "1.3"
      },
      "cuerpo": {
        "tamano": "14px",
        "peso": 400,
        "familia": "texto",
        "interlineado": "1.55"
      },
      "nota": {
        "tamano": "12px",
        "peso": 400,
        "familia": "texto",
        "interlineado": "1.4"
      },
      "etiqueta": {
        "tamano": "11px",
        "peso": 600,
        "familia": "texto",
        "interlineado": "1.2",
        "espaciado": "0.08em",
        "mayusculas": true
      }
    }
