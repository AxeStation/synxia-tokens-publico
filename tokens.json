      "color-accion-400": "{base.teal.400}",
      "color-accion-200": "{base.teal.200}",
      "color-accion-300": "{base.teal.300}",
      "color-accion-800": "{base.teal.800}",
      "color-senal-urgente": "{base.senal.urgente.base}",
      "color-senal-urgente-viva": "{base.senal.urgente.viva}",
      "color-senal-urgente-fuerte": "{base.senal.urgente.fuerte}",
      "color-senal-urgente-suave": "{base.senal.urgente.suave}",
      "color-senal-atencion": "{base.senal.atencion.base}",
      "color-senal-atencion-viva": "{base.senal.atencion.viva}",
      "color-senal-atencion-fuerte": "{base.senal.atencion.fuerte}",
      "color-senal-atencion-suave": "{base.senal.atencion.suave}",
      "color-senal-bien": "{base.senal.bien.base}",
      "color-senal-bien-viva": "{base.senal.bien.viva}",
      "color-senal-bien-fuerte": "{base.senal.bien.fuerte}",
      "color-senal-bien-suave": "{base.senal.bien.suave}"
