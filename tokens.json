      "color-borde-activo": "{base.borde.activo}",
      "color-peligro": "{base.estado.rojo}",
      "color-exito": "{base.estado.verde}",
      "color-aviso": "{base.estado.ambar}",
      "color-documento-acento": "{base.documento.acento}",
      "color-documento-acento-2": "{base.documento.acento2}",
      "color-correo-fondo-exterior": "{base.correo.fondoExterior}",
