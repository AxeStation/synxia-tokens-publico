        "suave": "#fffbeb"
      },
      "bien": {
        "viva": "#22c55e",
        "base": "#16a34a",
        "fuerte": "#15803d",
        "suave": "#f0fdf4"
      }
    }
  },
  "temas": {
    "claro": {
      "$comentario": "Único tema definido hoy (el dashboard NO tiene modo oscuro). El esquema está listo para un tema `oscuro`: al declararlo aquí, build.mjs emite los bloques prefers-color-scheme + data-theme sin tocar consumidores.",
      "color-accion": "{base.teal.600}",
      "color-accion-700": "{base.teal.700}",
      "color-accion-900": "{base.teal.900}",
      "color-accion-500": "{base.teal.500}",
      "color-accion-50": "{base.teal.50}",
      "color-accion-100": "{base.teal.100}",
      "color-sobre-accion": "#FFFFFF",
      "color-fondo": "{base.fondo.pagina}",
      "color-fondo-elevado": "{base.fondo.tarjeta}",
      "color-tinta": "{base.tintaApp.fuerte}",
      "color-tinta-900": "{base.tintaApp.fuerte}",
      "color-tinta-600": "{base.tintaApp.suave}",
      "color-tinta-400": "{base.tintaApp.muda}",
